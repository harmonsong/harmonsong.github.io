<h3 class="font-weight-medium">Specialized Courses</h3>
<div class="row mt-3">
  {% for course in site.data.resume.courses %}
    <div class="col-12 col-md-6 mb-3">
      <h6 class="font-weight-bold text-muted mb-1" style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">{{ course.category }}</h6>
      <p class="mb-0" style="font-size: 0.9rem; line-height: 1.6;">
        {{ course.courses | join: ' · ' }}
      </p>
    </div>
  {% endfor %}
</div>

